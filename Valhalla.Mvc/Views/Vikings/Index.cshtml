@model IEnumerable<Valhalla.Shared.DTOs.VikingDto>

@{
    ViewData["Title"] = "Valhalla Vikings";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Crimson+Pro:ital,wght@0,300;0,400;1,300&display=swap');

    :root {
        --gold: #c9a84c;
        --gold-light: #e8c96a;
        --iron: #8a8fa8;
        --iron-dark: #3a3d4a;
        --bg: #0e0f14;
        --bg-card: #13151e;
        --bg-row: #161820;
        --bg-row-hover: #1c1f2e;
        --text: #d4d6e0;
        --text-muted: #6b6f82;
        --danger: #c0392b;
        --danger-hover: #e74c3c;
        --success: #1a6b4a;
        --success-light: #2ecc71;
        --border: rgba(201,168,76,0.15);
    }

    body {
        background: var(--bg);
        color: var(--text);
        font-family: 'Crimson Pro', Georgia, serif;
    }

    .valhalla-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 2.5rem 0 2rem;
        border-bottom: 1px solid var(--border);
        margin-bottom: 2rem;
    }

    .valhalla-title {
        font-family: 'Cinzel', serif;
        font-size: 2rem;
        font-weight: 700;
        color: var(--gold);
        letter-spacing: .08em;
        text-shadow: 0 0 40px rgba(201,168,76,.2);
        display: flex;
        align-items: center;
        gap: .75rem;
    }

        .valhalla-title::before {
            content: '⚔';
            font-size: 1.4rem;
            opacity: .8;
        }

    .btn-rune {
        display: inline-flex;
        align-items: center;
        gap: .5rem;
        padding: .55rem 1.25rem;
        border-radius: 4px;
        font-family: 'Cinzel', serif;
        font-size: .78rem;
        font-weight: 600;
        letter-spacing: .1em;
        text-decoration: none;
        border: 1px solid var(--gold);
        color: var(--gold);
        background: transparent;
        transition: all .2s;
        cursor: pointer;
    }

        .btn-rune:hover {
            background: var(--gold);
            color: #0e0f14;
            box-shadow: 0 0 20px rgba(201,168,76,.3);
        }

        .btn-rune.danger {
            border-color: var(--danger);
            color: var(--danger);
        }

            .btn-rune.danger:hover {
                background: var(--danger);
                color: #fff;
                box-shadow: 0 0 20px rgba(192,57,43,.3);
            }

        .btn-rune svg {
            width: 15px;
            height: 15px;
            flex-shrink: 0;
        }

    .alert-valhalla {
        display: flex;
        align-items: center;
        gap: .75rem;
        padding: .85rem 1.25rem;
        border-radius: 4px;
        margin-bottom: 1.5rem;
        font-size: .95rem;
        border-left: 3px solid;
    }

        .alert-valhalla.success {
            background: rgba(26,107,74,.15);
            border-color: var(--success-light);
            color: var(--success-light);
        }

        .alert-valhalla.error {
            background: rgba(192,57,43,.12);
            border-color: var(--danger-hover);
            color: var(--danger-hover);
        }

    .viking-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 1rem;
    }

        .viking-table thead tr {
            border-bottom: 1px solid var(--border);
        }

        .viking-table th {
            font-family: 'Cinzel', serif;
            font-size: .7rem;
            font-weight: 600;
            letter-spacing: .14em;
            color: var(--gold);
            padding: .9rem 1rem;
            text-align: left;
            text-transform: uppercase;
        }

        .viking-table tbody tr {
            border-bottom: 1px solid rgba(255,255,255,.04);
            transition: background .15s;
        }

            .viking-table tbody tr:hover {
                background: var(--bg-row-hover);
            }

        .viking-table td {
            padding: .9rem 1rem;
            color: var(--text);
            vertical-align: middle;
        }

    .viking-name {
        font-family: 'Cinzel', serif;
        font-size: .95rem;
        color: var(--gold-light);
        font-weight: 600;
    }

    .badge-status {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        padding: .25rem .7rem;
        border-radius: 20px;
        font-size: .78rem;
        font-family: 'Cinzel', serif;
        letter-spacing: .06em;
    }

        .badge-status.approved {
            background: rgba(46,204,113,.12);
            color: var(--success-light);
            border: 1px solid rgba(46,204,113,.25);
        }

        .badge-status.pending {
            background: rgba(138,143,168,.1);
            color: var(--iron);
            border: 1px solid rgba(138,143,168,.2);
        }

    .actions-cell {
        display: flex;
        gap: .5rem;
        align-items: center;
    }

    .stat-val {
        font-variant-numeric: tabular-nums;
        color: var(--text);
    }

    .weapon-text {
        color: var(--iron);
        font-style: italic;
    }

    .empty-state {
        text-align: center;
        padding: 4rem 1rem;
        color: var(--text-muted);
        font-family: 'Cinzel', serif;
        letter-spacing: .08em;
        font-size: .9rem;
    }

        .empty-state::before {
            content: '🛡';
            display: block;
            font-size: 2.5rem;
            margin-bottom: 1rem;
            opacity: .4;
        }
</style>

<div class="valhalla-header">
    <div class="valhalla-title">Salón de Valhalla</div>
    <a asp-action="Create" class="btn-rune">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
        Nuevo Vikingo
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert-valhalla success">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12" /></svg>
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert-valhalla error">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><line x1="12" y1="8" x2="12" y2="12" /><line x1="12" y1="16" x2="12.01" y2="16" /></svg>
        @TempData["Error"]
    </div>
}

<table class="viking-table">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Batallas</th>
            <th>Arma</th>
            <th>Puntos</th>
            <th>Categoría</th>
            <th>Estado</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (!Model.Any())
        {
            <tr>
                <td colspan="7">
                    <div class="empty-state">Ningún guerrero ha llegado aún</div>
                </td>
            </tr>
        }
        @foreach (var item in Model)
        {
            <tr>
                <td class="viking-name">@item.Name</td>
                <td class="stat-val">@item.BattlesWon</td>
                <td class="weapon-text">@item.FavoriteWeapon</td>
                <td class="stat-val">@item.ValhallaPoints</td>
                <td class="stat-val">@item.Category</td>
                <td>
                    @if (item.IsApproved)
                    {
                        <span class="badge-status approved">
                            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12" /></svg>
                            Valhalla
                        </span>
                    }
                    else
                    {
                        <span class="badge-status pending">Pendiente</span>
                    }
                </td>
                <td>
                    <div class="actions-cell">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn-rune" title="Editar">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7" /><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z" /></svg>
                        </a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn-rune danger" title="Eliminar"
                           onclick="return confirm('¿Enviar a Hel a @item.Name?')">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6" /><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6" /><path d="M10 11v6" /><path d="M14 11v6" /><path d="M9 6V4h6v2" /></svg>
                        </a>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>
